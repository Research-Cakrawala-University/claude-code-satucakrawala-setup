# ============================================
# Claude Code - Team Configuration
# ============================================
# Copy file ini menjadi .env, lalu isi value-nya.
#   cp .env.example .env
#
# JANGAN commit file .env ke repository!
# ============================================

# --- API Provider ---
# Pilih salah satu: z.ai (GLM) atau Mimo (Xiomi)
# z.ai:   https://api.z.ai/api/anthropic
# Mimo:   https://token-plan-sgp.xiaomimimo.com/anthropic
ANTHROPIC_BASE_URL=https://api.z.ai/api/anthropic

# Auth token dari admin (z.ai atau Mimo)
ANTHROPIC_AUTH_TOKEN=MASUKAN_API_KEY_KAMU_DISINI

# --- Model Override ---
ANTHROPIC_MODEL=glm-5.1
ANTHROPIC_SMALL_FAST_MODEL=glm-4.5-air
ANTHROPIC_DEFAULT_SONNET_MODEL=glm-5.1
ANTHROPIC_DEFAULT_OPUS_MODEL=glm-5.1
ANTHROPIC_DEFAULT_HAIKU_MODEL=glm-4.5-air

# --- Connection ---
API_TIMEOUT_MS=3000000

# --- Disable Telemetry ---
CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=1
